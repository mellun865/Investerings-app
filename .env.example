# Mall för lokala miljövariabler till FastAPI-backend (backend/) och
# fristående skript (scripts/). Kopiera till en egen ".env" (gitignorad,
# läses automatiskt in - se services/config.py) och fyll i riktiga
# värden. Speglar samma nycklar som .streamlit/secrets.toml använder för
# Streamlit-appen - används inte båda samtidigt av samma process behöver
# man bara sätta värdena en gång per körsätt.

GEMINI_API_KEY=
FRED_API_KEY=

# Privat GitHub-repo för molnlagring av portfölj-/transaktionsdata.
# Lämna tomma för att falla tillbaka på lokala JSON-filer.
GITHUB_TOKEN=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main

# Telegram-notiser (frivilligt, används av scripts/news_notify.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
